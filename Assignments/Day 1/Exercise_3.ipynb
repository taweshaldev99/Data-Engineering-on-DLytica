    "### Exercise 3: File Validator"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "ee0266c4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Filename: dk.json\n"
     ]
    }
   ],
   "source": [
    "\n",
    "file_name = input(\"Enter a file name: \\n\")\n",
    "name = file_name.strip().lower()\n",
    "\n",
    "if file_name.endswith(\".csv\") or file_name.endswith(\".json\") or file_name.endswith(\".parquet\") :\n",
    "    print(f\"Filename: {name}\")\n",
    "else :\n",
    "    print(\"Enter valid filename\")"
   ]
