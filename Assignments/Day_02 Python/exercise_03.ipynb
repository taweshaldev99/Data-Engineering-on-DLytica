    "### Exercise 3: Clean Numeric Values"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "66b38448",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[100, 250, 300, 450]\n"
     ]
    }
   ],
   "source": [
    "raw_values = [100, None, 250, \"invalid\", 300, None, 450]\n",
    "clean_values = []\n",
    "for i in raw_values:\n",
    "    if not isinstance(i,int):\n",
    "        continue\n",
    "    clean_values.append(i)\n",
    "print(clean_values)\n",
    "\n"
   ]
